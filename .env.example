# --- Identifiants Telegram (API utilisateur, pas Bot API) ---
# À obtenir sur https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Nom de la session Telethon (un fichier .session sera créé avec ce nom)
TELEGRAM_SESSION_NAME=bet_tracker_session

# Groupe/canal à surveiller : username (sans @) ou ID numérique
TELEGRAM_TARGET_GROUP=nom_du_groupe_ou_id

# --- Stockage ---
DB_PATH=./storage/bets.db
IMAGES_DIR=./storage/images
LOG_FILE=./logs/pipeline.log

# --- Phase 2 : analyse IA des captures ---
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
