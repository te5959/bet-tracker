[Unit]
Description=Telegram Bet Tracker - Listener (Phase 1)
After=network.target

[Service]
Type=simple
# Adapter le chemin si le projet est ailleurs
WorkingDirectory=/opt/telegram-bet-tracker
ExecStart=/opt/telegram-bet-tracker/venv/bin/python /opt/telegram-bet-tracker/main.py
Restart=always
RestartSec=10
User=root
EnvironmentFile=/opt/telegram-bet-tracker/.env

# Limite raisonnable, le process est très léger
MemoryMax=512M

[Install]
WantedBy=multi-user.target
