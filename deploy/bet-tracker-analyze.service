[Unit]
Description=Telegram Bet Tracker - Analyse IA (Phase 2)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-bet-tracker
ExecStart=/opt/telegram-bet-tracker/venv/bin/python /opt/telegram-bet-tracker/analyze_pending.py --loop 30
Restart=always
RestartSec=10
User=root
EnvironmentFile=/opt/telegram-bet-tracker/.env
MemoryMax=512M

[Install]
WantedBy=multi-user.target
