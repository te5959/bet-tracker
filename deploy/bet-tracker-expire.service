[Unit]
Description=Telegram Bet Tracker - Expiration des paris (Phase 5)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-bet-tracker
# Vérification toutes les heures : pas besoin de plus fréquent, le délai
# d'expiration lui-même est de 24h par défaut.
ExecStart=/opt/telegram-bet-tracker/venv/bin/python /opt/telegram-bet-tracker/expire_pending.py --loop 3600
Restart=always
RestartSec=10
User=root
EnvironmentFile=/opt/telegram-bet-tracker/.env
MemoryMax=256M

[Install]
WantedBy=multi-user.target
