[Unit]
Description=Telegram Bet Tracker - Expiration des paris (Phase 5)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-bet-tracker
# Vérification toutes les 15 min : le délai principal (5h après le début
# du match) est bien plus court que l'ancien délai fixe de 24h, une
# vérification plus fréquente évite un retard inutile.
ExecStart=/opt/telegram-bet-tracker/venv/bin/python /opt/telegram-bet-tracker/expire_pending.py --loop 900
Restart=always
RestartSec=10
User=root
EnvironmentFile=/opt/telegram-bet-tracker/.env
MemoryMax=256M

[Install]
WantedBy=multi-user.target
