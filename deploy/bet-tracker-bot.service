[Unit]
Description=Telegram Bet Tracker - Bot statistiques (Phase 6)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-bet-tracker
ExecStart=/opt/telegram-bet-tracker/venv/bin/python /opt/telegram-bet-tracker/run_bot.py
Restart=always
RestartSec=10
User=root
EnvironmentFile=/opt/telegram-bet-tracker/.env
MemoryMax=256M

[Install]
WantedBy=multi-user.target
